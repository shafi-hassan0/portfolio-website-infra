# Copy this file to .env and fill in real values. .env is gitignored.

# The domain Caddy will request a TLS certificate for and serve the site on.
# Must resolve (via public DNS or your router's port forwarding) to this server on ports 80 and 443.
DOMAIN=portfolio.example.com

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
