# Copy this file to .env and fill in real values. .env is gitignored.

# Cloudflare Tunnel token. Create the tunnel in the Cloudflare Zero Trust dashboard:
# Networks > Tunnels > Create a tunnel > Docker, add a public hostname pointing at
# http://web:80, then copy the token from the install command it gives you.
TUNNEL_TOKEN=

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
